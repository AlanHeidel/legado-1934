# Copiar a .env.local y reiniciar Vite tras modificar estos valores.
# Habilitar Maps Embed API y restringir la key a los dominios del sitio.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
# Dirección real completa: calle, número, ciudad, provincia y país.
VITE_CLUB_ADDRESS="Avenida Malarín 2260, San Salvador, Entre Ríos, Argentina"
# Opcional: coordenadas latitud,longitud para mayor precisión en el mapa.
# Si queda vacío, se usa VITE_CLUB_ADDRESS.
VITE_GOOGLE_MAPS_QUERY=
# Si queda vacío, se usa el horario predeterminado del componente.
VITE_CLUB_HOURS=
# Enlace al perfil oficial del club.
VITE_INSTAGRAM_URL=https://www.instagram.com/legado.1934/
